{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node", "react", "react-dom"],
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "include": ["src/**/*"]
}
